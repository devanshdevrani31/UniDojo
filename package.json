{
  "name": "unidojo",
  "private": true,
  "version": "0.0.0",
  "description": "Play study games built from other students' lecture notes.",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "validate-bundle": "node scripts/validate-bundle.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
