# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only. Never expose to the browser.

# --- Origins ---
# These MUST be different registrable domains, not subdomains of each other.
# See docs/decisions/0001-two-origins.md
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SANDBOX_ORIGIN=http://localhost:3001

# --- Limits ---
MAX_BUNDLE_BYTES=5242880
MAX_BUNDLE_FILES=50
